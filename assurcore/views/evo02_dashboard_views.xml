<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         EVO02 : Tableau de Bord — bordereaux standards du courtage
         + indicateurs GRH/qualite. Mesures non pertinentes retirees.
         ================================================================== -->

    <!-- 0. Nettoyage des mesures de l'analyse quittances -->
    <record id="view_receipt_pivot_clean_evo02" model="ir.ui.view">
        <field name="name">insurance.receipt.pivot.clean.evo02</field>
        <field name="model">insurance.receipt</field>
        <field name="inherit_id" ref="assurcore.view_insurance_receipt_pivot"/>
        <field name="arch" type="xml">
            <field name="timbre_fiscal" position="replace"/>
            <pivot position="inside">
                <field name="montant_honoraire_ht" invisible="1"/>
                <field name="montant_tva" invisible="1"/>
                <field name="taux_tva" invisible="1"/>
                <field name="prime_echeance" invisible="1"/>
                <field name="timbre_fiscal" invisible="1"/>
                <field name="payment_lead_days" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_receipt_graph_clean_evo02" model="ir.ui.view">
        <field name="name">insurance.receipt.graph.clean.evo02</field>
        <field name="model">insurance.receipt</field>
        <field name="inherit_id" ref="assurcore.view_insurance_receipt_graph"/>
        <field name="arch" type="xml">
            <graph position="inside">
                <field name="montant_honoraire_ht" invisible="1"/>
                <field name="montant_tva" invisible="1"/>
                <field name="taux_tva" invisible="1"/>
                <field name="prime_echeance" invisible="1"/>
                <field name="timbre_fiscal" invisible="1"/>
            </graph>
        </field>
    </record>

    <!-- ============ BORDEREAUX METIER (standards courtage) ============ -->

    <!-- B1. Bordereau de PRODUCTION : primes emises par compagnie/branche/mois -->
    <record id="view_op_pivot_production" model="ir.ui.view">
        <field name="name">op.pivot.production</field>
        <field name="model">insurance.operation</field>
        <field name="arch" type="xml">
            <pivot string="Bordereau de production" display_quantity="1">
                <field name="company_ins_id" type="row"/>
                <field name="branche" type="row"/>
                <field name="date_op" interval="month" type="col"/>
                <field name="montant_prime" type="measure" string="Primes émises (TND)"/>
                <field name="commission" type="measure" string="Commission (TND)"/>
            </pivot>
        </field>
    </record>
    <record id="view_op_graph_production" model="ir.ui.view">
        <field name="name">op.graph.production</field>
        <field name="model">insurance.operation</field>
        <field name="arch" type="xml">
            <graph string="Production mensuelle" type="bar" stacked="1">
                <field name="date_op" interval="month" type="row"/>
                <field name="company_ins_id" type="col"/>
                <field name="montant_prime" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dash_production" model="ir.actions.act_window">
        <field name="name">Bordereau de production</field>
        <field name="res_model">insurance.operation</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'pivot','view_id':ref('view_op_pivot_production')}),
            (0,0,{'view_mode':'graph','view_id':ref('view_op_graph_production')})]"/>
        <field name="domain">[('state', '!=', 'canceled')]</field>
        <field name="help" type="html"><p>Primes émises et commissions par compagnie, branche et mois — le bordereau de production du courtier.</p></field>
    </record>
    <menuitem id="menu_dash_production" name="Bordereau de production"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dash_production" sequence="50"/>

    <!-- B2. Bordereau d'ENCAISSEMENT : par mode de paiement et periode -->
    <record id="view_imp_pivot_encaissement" model="ir.ui.view">
        <field name="name">imp.pivot.encaissement</field>
        <field name="model">insurance.settlement.imputation</field>
        <field name="arch" type="xml">
            <pivot string="Bordereau d'encaissement" display_quantity="1">
                <field name="date_imputation" interval="month" type="row"/>
                <field name="type_reg" type="col"/>
                <field name="montant_impute" type="measure" string="Encaissé (TND)"/>
            </pivot>
        </field>
    </record>
    <record id="view_imp_graph_encaissement" model="ir.ui.view">
        <field name="name">imp.graph.encaissement</field>
        <field name="model">insurance.settlement.imputation</field>
        <field name="arch" type="xml">
            <graph string="Encaissements par mode" type="bar" stacked="1">
                <field name="date_imputation" interval="month" type="row"/>
                <field name="type_reg" type="col"/>
                <field name="montant_impute" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dash_encaissement" model="ir.actions.act_window">
        <field name="name">Bordereau d'encaissement</field>
        <field name="res_model">insurance.settlement.imputation</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'pivot','view_id':ref('view_imp_pivot_encaissement')}),
            (0,0,{'view_mode':'graph','view_id':ref('view_imp_graph_encaissement')})]"/>
        <field name="help" type="html"><p>Encaissements par mode de paiement (chèque, espèces, virement…) et par mois.</p></field>
    </record>
    <menuitem id="menu_dash_encaissement" name="Bordereau d'encaissement"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dash_encaissement" sequence="55"/>

    <!-- B3. BALANCE DES IMPAYES par anciennete d'emission -->
    <record id="view_receipt_pivot_impayes" model="ir.ui.view">
        <field name="name">receipt.pivot.impayes</field>
        <field name="model">insurance.receipt</field>
        <field name="arch" type="xml">
            <pivot string="Balance des impayés" display_quantity="1">
                <field name="partner_id" type="row"/>
                <field name="date_emission" interval="quarter" type="col"/>
                <field name="amount_open" type="measure" string="Reste dû (TND)"/>
            </pivot>
        </field>
    </record>
    <record id="view_receipt_graph_impayes" model="ir.ui.view">
        <field name="name">receipt.graph.impayes</field>
        <field name="model">insurance.receipt</field>
        <field name="arch" type="xml">
            <graph string="Impayés par ancienneté" type="bar">
                <field name="date_emission" interval="quarter" type="row"/>
                <field name="amount_open" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dash_impayes" model="ir.actions.act_window">
        <field name="name">Balance des impayés</field>
        <field name="res_model">insurance.receipt</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_receipt_graph_impayes')}),
            (0,0,{'view_mode':'pivot','view_id':ref('view_receipt_pivot_impayes')})]"/>
        <field name="domain">[('amount_open', '&gt;', 0)]</field>
        <field name="help" type="html"><p>Restes dus par client et par trimestre d'émission — la balance âgée du recouvrement. Trier la colonne Reste dû pour obtenir le top des débiteurs.</p></field>
    </record>
    <menuitem id="menu_dash_impayes" name="Balance des impayés"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dash_impayes" sequence="60"/>

    <!-- B4. Bordereau de REVERSEMENT compagnie -->
    <record id="view_imp_pivot_reversement" model="ir.ui.view">
        <field name="name">imp.pivot.reversement</field>
        <field name="model">insurance.settlement.imputation</field>
        <field name="arch" type="xml">
            <pivot string="Reversement compagnie" display_quantity="1">
                <field name="company_ins_id" type="row"/>
                <field name="date_imputation" interval="month" type="col"/>
                <field name="montant_impute" type="measure" string="Encaissé pour compte (TND)"/>
            </pivot>
        </field>
    </record>
    <record id="action_dash_reversement" model="ir.actions.act_window">
        <field name="name">Reversement compagnie</field>
        <field name="res_model">insurance.settlement.imputation</field>
        <field name="view_mode">pivot</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'pivot','view_id':ref('view_imp_pivot_reversement')})]"/>
        <field name="help" type="html"><p>Primes encaissées pour le compte de chaque compagnie, par mois — base des bordereaux de reversement (avant déduction des commissions).</p></field>
    </record>
    <menuitem id="menu_dash_reversement" name="Reversement compagnie"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dash_reversement" sequence="65"/>

    <!-- B5. Nouvelle production vs RENOUVELLEMENTS (retention) -->
    <record id="view_op_graph_renouvellement" model="ir.ui.view">
        <field name="name">op.graph.renouvellement</field>
        <field name="model">insurance.operation</field>
        <field name="arch" type="xml">
            <graph string="Nouvelle production vs renouvellements" type="bar" stacked="1">
                <field name="date_op" interval="year" type="row"/>
                <field name="code_operation" type="col"/>
            </graph>
        </field>
    </record>
    <record id="action_dash_renouvellement" model="ir.actions.act_window">
        <field name="name">Production vs renouvellements</field>
        <field name="res_model">insurance.operation</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_op_graph_renouvellement')})]"/>
        <field name="domain">[('code_operation', 'in', ('EMI', 'REN')), ('state', '!=', 'canceled')]</field>
        <field name="help" type="html"><p>Émissions initiales vs renouvellements par an — indicateur de rétention du portefeuille.</p></field>
    </record>
    <menuitem id="menu_dash_renouvellement" name="Production vs renouvellements"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dash_renouvellement" sequence="70"/>

    <!-- ============ INDICATEURS GRH / QUALITE ============ -->

    <record id="view_imputation_graph_rendement" model="ir.ui.view">
        <field name="name">imputation.graph.rendement</field>
        <field name="model">insurance.settlement.imputation</field>
        <field name="arch" type="xml">
            <graph string="Dossiers traités par utilisateur" type="bar" stacked="1">
                <field name="create_date" interval="month" type="row"/>
                <field name="create_uid" type="col"/>
            </graph>
        </field>
    </record>
    <record id="action_dashboard_rendement" model="ir.actions.act_window">
        <field name="name">Rendement par gestionnaire</field>
        <field name="res_model">insurance.settlement.imputation</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_imputation_graph_rendement')})]"/>
        <field name="domain">[('is_reconstructed', '=', False)]</field>
        <field name="help" type="html"><p>Imputations saisies par gestionnaire et par mois (hors historique migré) — indicateur de rendement individuel.</p></field>
    </record>
    <menuitem id="menu_dash_rendement" name="Rendement par gestionnaire"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dashboard_rendement" sequence="75"/>

    <record id="view_receipt_graph_delai" model="ir.ui.view">
        <field name="name">receipt.graph.delai</field>
        <field name="model">insurance.receipt</field>
        <field name="arch" type="xml">
            <graph string="Délai moyen de paiement (jours)" type="line">
                <field name="date_emission" interval="month" type="row"/>
                <field name="payment_lead_days" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dashboard_delai" model="ir.actions.act_window">
        <field name="name">Délai de paiement des mémoires</field>
        <field name="res_model">insurance.receipt</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_receipt_graph_delai')})]"/>
        <field name="domain">[('payment_lead_days', '!=', False)]</field>
        <field name="help" type="html"><p>Temps moyen entre l'émission d'une mémoire et son solde complet.</p></field>
    </record>
    <menuitem id="menu_dash_delai" name="Délai de paiement"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dashboard_delai" sequence="80"/>

    <record id="view_operation_graph_sante" model="ir.ui.view">
        <field name="name">operation.graph.sante</field>
        <field name="model">insurance.operation</field>
        <field name="arch" type="xml">
            <graph string="Santé du portefeuille" type="pie">
                <field name="health_state" type="row"/>
            </graph>
        </field>
    </record>
    <record id="action_dashboard_sante" model="ir.actions.act_window">
        <field name="name">Santé du portefeuille</field>
        <field name="res_model">insurance.operation</field>
        <field name="view_mode">graph,tree</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_operation_graph_sante')})]"/>
        <field name="help" type="html"><p>Répartition des opérations saines / en anomalie. Détail dans le menu Qualité des données.</p></field>
    </record>
    <menuitem id="menu_dash_sante" name="Santé du portefeuille"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dashboard_sante" sequence="85"/>

    <record id="view_partner_graph_fidelite" model="ir.ui.view">
        <field name="name">partner.graph.fidelite</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph string="Fidélité clients" type="pie">
                <field name="client_state" type="row"/>
            </graph>
        </field>
    </record>
    <record id="action_dashboard_fidelite" model="ir.actions.act_window">
        <field name="name">Fidélité clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">graph,tree</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_partner_graph_fidelite')})]"/>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="help" type="html"><p>Répartition du portefeuille clients par statut de fidélité.</p></field>
    </record>
    <menuitem id="menu_dash_fidelite" name="Fidélité clients"
              parent="assurcore.menu_assurcore_dashboard"
              action="action_dashboard_fidelite" sequence="90"/>
</odoo>

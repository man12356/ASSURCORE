<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 1. VUE LISTE -->
  <record id="view_insurance_operation_type_tree" model="ir.ui.view">
    <field name="name">insurance.operation.type.tree</field>
    <field name="model">insurance.operation.type</field>
    <field name="arch" type="xml">
      <tree string="Types d'Opérations">
        <field name="code_operation1" string="Code 1"/>
        <field name="code_operation2" string="Code 2" optional="show"/>
        <field name="designation" string="Désignation"/>
        <field name="branche" string="Branche"/>
        <field name="risque" string="Risque" optional="hide"/>
        <field name="libelle_honoraire" string="Libellé Honoraire" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- 2. VUE FORM -->
  <record id="view_insurance_operation_type_form" model="ir.ui.view">
    <field name="name">insurance.operation.type.form</field>
    <field name="model">insurance.operation.type</field>
    <field name="arch" type="xml">
      <form string="Type d'Opération">
        <sheet>
          <div class="oe_title">
            <label for="code_label"/>
            <h1><field name="code_label" readonly="1"/></h1>
          </div>
          <group>
            <group string="Codes Oracle (4 niveaux)">
              <field name="code_operation1"/>
              <field name="code_operation2"/>
              <field name="code_operation3"/>
              <field name="code_operation4"/>
            </group>
            <group string="Classification">
              <field name="branche"/>
              <field name="risque"/>
            </group>
          </group>
          <group string="Libellés">
            <field name="designation"/>
            <field name="libelle_honoraire"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- 3. VUE RECHERCHE -->
  <record id="view_insurance_operation_type_search" model="ir.ui.view">
    <field name="name">insurance.operation.type.search</field>
    <field name="model">insurance.operation.type</field>
    <field name="arch" type="xml">
      <search string="Recherche types opérations">
        <field name="code_operation1" string="Code"/>
        <field name="designation"/>
        <field name="branche"/>
        <separator/>
        <group expand="0" string="Regrouper par">
          <filter name="group_branche" string="Branche"
                  context="{'group_by': 'branche'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- 4. ACTION -->
  <record id="action_insurance_operation_type" model="ir.actions.act_window">
    <field name="name">Types d'Opérations</field>
    <field name="res_model">insurance.operation.type</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_insurance_operation_type_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Référentiel des codes opérations Oracle
      </p>
      <p>87 codes couvrant toutes les branches et types d'actes.</p>
    </field>
  </record>

  <!-- 5. MENU sous Paramétrage -->
  <menuitem id="menu_insurance_operation_type"
            name="Types d'Opérations"
            parent="menu_assurcore_parametrage"
            action="action_insurance_operation_type"
            sequence="60"
            groups="assurcore.group_assurcore_manager"/>

</odoo>
